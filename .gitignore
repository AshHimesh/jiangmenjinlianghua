# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- 打包产物 ---
dist/
build/
*.spec

# --- 运行期数据 ---
cache.db
selftest.log
error.log
reports/
*.log
# 金十额度计数（运行时状态，按北京时间自然日重置）
jin10_quota.json

# --- 密钥：绝不入库 ---
config.json

# --- 大体积二进制（参赛交付物里的视频与网盘压缩包，另行保管） ---
*.mp4
参赛文件/网盘上传/*.zip

# --- 开发期临时件：以 _ 开头的脚本/产物，以及 tools/ 下的一次性探查文件 ---
